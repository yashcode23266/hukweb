# Leave VITE_API_BASE_URL empty to use the browser-only demo data.
# Set it to the public Spring Boot URL to load real MySQL order records.
# Do not add a trailing slash.
VITE_API_BASE_URL=https://your-spring-boot-service.up.railway.app

# Add the public Razorpay key only when reconnecting real checkout.
VITE_RAZORPAY_KEY_ID=
